---
import Layout from '../../layouts/Layout.astro';
import SectionBlock from '../../components/SectionBlock.astro';
import { useTranslations } from '../../i18n/ui';

const lang = 'en';
const t = useTranslations(lang);
---

<Layout title="Portfolio | About" lang={lang}>
	<section class="page-head">
		<h1>{t('about.page.title')}</h1>
		<p>{t('about.page.p1')}</p>
	</section>

	<div class="grid-2">
		<SectionBlock title={t('about.title')} copy={t('about.page.p1')} />
		<SectionBlock title={t('projects.title')} copy={t('about.page.p2')} />
	</div>

	<section class="section-block">
		<h2>{t('education.title')}</h2>
		<ul class="study-list">
			<li>
				<strong>{t('education.item1.degree')}</strong>
				<p>{t('education.item1.school')}</p>
			</li>
			<li>
				<strong>{t('education.item2.degree')}</strong>
				<p>{t('education.item2.school')}</p>
			</li>
		</ul>
	</section>
</Layout>
