---
const projects = [
  {
    title: "Portfolio Personal",
    description:
      "Este mismo portfolio — diseñado y desarrollado con Astro. Arquitectura de islas, CSS moderno y enfoque en rendimiento.",
    tags: ["Astro", "CSS", "TypeScript"],
    github: "https://github.com/josesecadura/portfolio",
    demo: null,
    featured: true,
  },
  {
    title: "E-commerce App",
    description:
      "Tienda online completa con carrito de compras, pasarela de pago y panel de administración. Backend con Node.js y base de datos PostgreSQL.",
    tags: ["React", "Node.js", "PostgreSQL"],
    github: "#",
    demo: null,
    featured: false,
  },
  {
    title: "Dashboard de Análisis",
    description:
      "Panel de control interactivo para visualización de datos en tiempo real con gráficos dinámicos y filtros avanzados.",
    tags: ["Vue.js", "D3.js", "REST API"],
    github: "#",
    demo: null,
    featured: false,
  },
  {
    title: "API RESTful",
    description:
      "Servicio backend escalable con autenticación JWT, documentación Swagger y despliegue continuo en contenedores Docker.",
    tags: ["Node.js", "Express", "Docker"],
    github: "#",
    demo: null,
    featured: false,
  },
];
---

<section class="projects" id="proyectos">
  <div class="projects__inner">
    <div class="section-header">
      <span class="section-tag">02. Proyectos</span>
      <h2 class="section-title">Lo que he construido</h2>
    </div>
    <div class="projects__grid">
      {projects.map((project) => (
        <article class={`project-card ${project.featured ? "project-card--featured" : ""}`}>
          <div class="project-card__top">
            <div class="project-card__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                <line x1="3" y1="9" x2="21" y2="9"/>
                <line x1="9" y1="21" x2="9" y2="9"/>
              </svg>
            </div>
            <div class="project-card__links">
              {project.github && (
                <a href={project.github} target="_blank" rel="noopener noreferrer" aria-label={`Ver código de ${project.title} en GitHub`}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                  </svg>
                </a>
              )}
              {project.demo && (
                <a href={project.demo} target="_blank" rel="noopener noreferrer" aria-label={`Ver demo de ${project.title}`}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                    <polyline points="15 3 21 3 21 9"/>
                    <line x1="10" y1="14" x2="21" y2="3"/>
                  </svg>
                </a>
              )}
            </div>
          </div>
          <h3 class="project-card__title">{project.title}</h3>
          <p class="project-card__desc">{project.description}</p>
          <ul class="project-card__tags">
            {project.tags.map((tag) => (
              <li class="project-card__tag">{tag}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .projects {
    padding: 5rem 2rem;
  }

  .projects__inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .section-tag {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--color-text);
  }

  .projects__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .project-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color var(--transition), transform var(--transition), box-shadow var(--transition);
  }

  .project-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-6px);
    box-shadow: 0 16px 40px rgba(124, 106, 247, 0.12);
  }

  .project-card--featured {
    border-color: rgba(124, 106, 247, 0.4);
    background: linear-gradient(135deg, var(--color-surface), rgba(124, 106, 247, 0.05));
  }

  .project-card__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .project-card__icon {
    color: var(--color-accent);
  }

  .project-card__links {
    display: flex;
    gap: 0.75rem;
  }

  .project-card__links a {
    color: var(--color-text-muted);
    transition: color var(--transition);
  }

  .project-card__links a:hover {
    color: var(--color-accent);
  }

  .project-card__title {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .project-card__desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    flex: 1;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .project-card__tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent-light);
    background: rgba(124, 106, 247, 0.1);
    padding: 0.2rem 0.65rem;
    border-radius: 4px;
  }
</style>
